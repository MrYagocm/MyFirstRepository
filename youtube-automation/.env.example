# === FREE TIER (start here - $0/month) ===
GEMINI_API_KEY=your_gemini_key_here
# Get it: https://aistudio.google.com/apikey (free, 60 req/min)

GOOGLE_CLOUD_PROJECT=your_project_id
# Get it: https://console.cloud.google.com (free TTS: 1M chars/month)

PEXELS_API_KEY=your_pexels_key
# Get it: https://www.pexels.com/api/ (free, stock footage)

# === CHEAP TIER (optional, ~$3/month) ===
SILICONFLOW_API_KEY=your_siliconflow_key
# Get it: https://siliconflow.com (FLUX images at $0.015/image)

# === PREMIUM TIER (optional upgrades) ===
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Only if you want Claude for premium scripts ($0.02/script)

ELEVENLABS_API_KEY=xxxxx
# Only for premium voice quality ($5/month starter)

# === YOUTUBE (required for upload) ===
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
# Get it: Google Cloud Console > YouTube Data API v3 > OAuth 2.0

# === LLM/TTS PROVIDER SELECTION ===
LLM_PROVIDER=gemini
# Options: gemini (free), claude, openai

TTS_PROVIDER=google_cloud
# Options: google_cloud (free), edge (free), voxtral (cheap), elevenlabs (premium)

IMAGE_PROVIDER=siliconflow
# Options: siliconflow (cheapest), google_imagen, replicate

# === AFFILIATE LINKS (add as you get approved) ===
AFFILIATE_AUDIBLE=
AFFILIATE_KINDLE=
AFFILIATE_CAMBLY=
AFFILIATE_ITALKI=
AFFILIATE_PREPLY=
AFFILIATE_NORDVPN=
AFFILIATE_HOSTINGER=
